NODE_ENV=development
# SSD-Backend is the merged Auth/Users/Roles/Customers/Masters/POS/Inventory/
# Payments/Reports API (formerly User-Service + Catalog-Service +
# Payment-Service + Notification-Service, four separate processes/ports).
# One port for the whole thing now. On Render, PORT is injected
# automatically and overrides this default — do not set it manually there.
PORT=5003
API_PREFIX=/api/v1
# Comma-separated — allows a Vercel production domain and its per-branch
# preview domains at once, e.g.
# https://ssd-admin.vercel.app,https://ssd-frontend-git-develop-xxx.vercel.app
CORS_ORIGIN=http://localhost:3000

MONGO_URI=mongodb://127.0.0.1:27017/ssd-temple

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_COST=12

ACTIVATION_TOKEN_TTL_HOURS=48
RESET_TOKEN_TTL_MINUTES=30
MOBILE_OTP_TTL_MINUTES=5

# Staff activation and password-reset emails.
ADMIN_APP_URL=http://localhost:3000
# Devotee activation and password-reset emails. On UAT this is the customer
# panel, for example https://uatbookings.sivadurga.com. Locally it is the
# same frontend as ADMIN_APP_URL.
CUSTOMER_APP_URL=http://localhost:3000

# Email header logo — a permanent Cloudinary URL, not built from
# ADMIN_APP_URL, because a `localhost` URL can never be reached by a real
# mail client. Leave unset to use the default temple logo.
EMAIL_LOGO_URL=

# --- Notifications --------------------------------------------------------
# Keep this true until a real email provider + SMS sender are provisioned.
# While true, nothing below is actually called — every email is logged to
# the console and to logs/dry-run-emails.log instead, so the
# activation/forgot-password flow can be tested safely with no keys at all.
DRY_RUN_NOTIFICATIONS=true

# Same dual-provider approach as Syncetra-Backend: Brevo's HTTP API first
# (Gmail SMTP is blocked outbound on Render's free tier), falling back to
# Gmail SMTP for local dev or a paid Render plan. Set ONE of the two pairs
# below. Swap this block for AWS SES once the project moves onto AWS.
BREVO_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENDER_EMAIL_ID=no-reply@example-temple.org

# --- AWS (UAT/production): SES email + S3 images --------------------------
# No AWS keys here: on EC2 the instance role is used. Email goes through SES unless
# BREVO_API_KEY / GMAIL_* above are set; SENDER_EMAIL_ID must be a verified SES identity.
# Image uploads go to S3 when S3_BUCKET is set, otherwise to Cloudinary (below).
AWS_REGION=ap-southeast-1
# Optional: most emails sent per second (default 5). Bursts are spaced out, never dropped.
# EMAIL_MAX_PER_SECOND=5
# Optional: most password-reset emails to one address per hour (default 3).
# FORGOT_PASSWORD_MAX_PER_HOUR=3
S3_BUCKET=
# Optional: CloudFront domain for the images (blank = the bucket's own https address)
S3_PUBLIC_BASE_URL=

# --- Profile image uploads (Cloudinary) ------------------------------------
# See common/utils/cloudinary.js / common/middleware/upload.js. Local disk
# isn't an option on Render (ephemeral filesystem, wiped on every redeploy),
# and this stays unchanged after the move to AWS.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reserved for the mobile-change OTP flow (not wired up yet)
SMS_SENDER_ID=SSDTEMPLE

# --- Seed script ------------------------------------------------------------
DEFAULT_ENTITY_CODE=SST
SEED_SUPER_ADMIN_NAME=Temple System Admin
SEED_SUPER_ADMIN_EMAIL=superadmin@example-temple.org

# --- NETS payment callback (controllers/payments/nets/callback) ------------
# Shared secret between this backend and the local Nets-Service EXE — the
# EXE sends it as the X-Nets-Callback-Secret header on every automatic
# payment confirmation. Leave unset to use config/env.js's own hardcoded
# default, which already matches the EXE's amq/ssdBackendClient.js constant
# — only set this if a real, unique-per-deployment secret is ever wanted.
NETS_CALLBACK_SECRET=

# --- PayNow (DBS PayNow Corporate) — see docs/paynow-integration.md ----------
# PAYNOW_MODE decides everything below:
#   development  mock QR codes that no banking app can pay + the mock-confirm
#                route. Nothing below needs a real value. Safe for local/UAT.
#   production   the real integration. Every value below must be set to the
#                temple's OWN details (from DBS); the server REFUSES TO START
#                if one is missing. It never falls back to a mock.
#   manual       no QR and no bank connection: the cashier / admin confirms a
#                PayNow payment by hand (enters the bank's transaction reference).
#                Needs nothing below. Use this for UAT / production until the
#                real DBS integration is set up.
#   (unset)      development on a developer machine; manual on a server
#                running with NODE_ENV=production.
# Values in angle brackets are placeholders until the PayNow team confirms
# them — do not invent real ones.
PAYNOW_MODE=
# Production only. "jar" = DBS's PayQRSDK.jar (needs Java on the server),
# "native" = built in JS, same output. No default — name one.
PAYNOW_QR_ENGINE=
# Must be true only once every value here and both key files are the
# temple's own (never HEB's).
PAYNOW_CREDENTIALS_ARE_SSD_OWN=false
# Merchant / QR details (all from DBS)
PAYNOW_MERCHANT_CATEGORY_CODE=<from DBS>
PAYNOW_TXN_CURRENCY=702
PAYNOW_COUNTRY_CODE=SG
PAYNOW_MERCHANT_NAME=<registered name, max 25 chars>
PAYNOW_MERCHANT_CITY=<city, max 15 chars>
PAYNOW_GLOBAL_UNIQUE_ID=SG.PAYNOW
PAYNOW_PROXY_TYPE=<2 = UEN, 0 = mobile>
PAYNOW_PROXY_VALUE=<the temple's PayNow UEN, with any suffix DBS assigns>
# 0 = the payer cannot change the amount (recommended)
PAYNOW_EDITABLE_AMOUNT=0
# 12 = one-time QR, 11 = reusable
PAYNOW_POINT_OF_INITIATION=12
PAYNOW_QR_COLOR_CODE=#7C1A78
# QR text details still to be confirmed with DBS (defaults match DBS's jar)
PAYNOW_PAYLOAD_FORMAT_INDICATOR=00
PAYNOW_PROXY_EXPIRY_FORMAT=datetime
PAYNOW_PROXY_EXPIRY_DAYS=365
# Confirmation (ICN) — key files stay OUT of git; on the server keep them in
# a protected folder mounted read-only into the container.
#   PUBLIC  = DBS's public key (verifies their signature)
#   PRIVATE = the temple's private key (decrypts)
PAYNOW_PUBLIC_KEY_PATH=<path to DBS public key .asc>
PAYNOW_PRIVATE_KEY_PATH=<path to the temple private key .asc>
# Informational: the URL registered with DBS for the ICN webhook.
PAYNOW_ICN_RESPONSE_URL=https://api.example.com/api/v1/payments/paynow/icn-response

# --- IP allow list for the admin and POS sites (docs/ip-access-control.md) ---
# The list and its mode (off / report / enforce) are managed on screen by the System Admin:
# Administration > Access Control. These two live OUTSIDE the screen, as the way back in:
# addresses/ranges that are always let in, and an emergency switch that turns the restriction off.
IP_ACCESS_ALWAYS_ALLOWED=
IP_ACCESS_FORCE_OFF=false

# General API limit per IP per 15 minutes (default 1500)
API_RATE_LIMIT_MAX=1500
